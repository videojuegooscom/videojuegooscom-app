{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/producto/:id", "destination": "/producto/[id]" },
    { "source": "/servicio/:id", "destination": "/servicio/[id]" },
    { "source": "/politicas/:slug", "destination": "/politicas/[slug]" },
    { "source": "/chat/:chatId", "destination": "/chat/[chatId]" },
    { "source": "/admin/cliente/:userId", "destination": "/admin/cliente/[userId]" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}