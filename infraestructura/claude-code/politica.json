  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /etc/claude-code/hooks/guardian.py",
            "timeout": 15
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /etc/claude-code/hooks/bloquear-config.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
