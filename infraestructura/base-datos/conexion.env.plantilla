# == VIDEOJUEGOSZARAGOZA ======================================================
# Archivo:        infraestructura/base-datos/conexion.env.plantilla
#                 (instalar-sql.sh la copia, sin valores, a /etc/videojuegoszaragoza-sql/conexion.env)
# Función:        Plantilla de la conexión del broker vz-sql al Supabase real. SOLO NOMBRES:
#                 nunca pongas valores en el repositorio.
# Para qué sirve: Rellenar en el servidor con «sudoedit /etc/videojuegoszaragoza-sql/conexion.env».
#                 Permisos: root:vz-sql 0640 (videojuegoszaragoza —Claude— no puede leerlo).
# Conectado con:  broker.py, vz-sql.service.
# Dependencias:   Rol vz_agente (ACCION_MANUAL__rol_vz_agente_2026-11-27.sql).
# =============================================================================
# Host del pooler de Supabase (Connect → Session pooler).
VZ_SQL_HOST=
# 5432 = pooler en modo sesión.
VZ_SQL_PORT=5432
VZ_SQL_DB=postgres
# En el pooler: vz_agente.<project_ref>
VZ_SQL_USUARIO=
# La contraseña que pusiste al crear el rol (nunca en el repositorio).
VZ_SQL_CONTRASENA=
# verify-full con el certificado de Supabase (Settings → Database → SSL Configuration → Download).
VZ_SQL_SSLMODE=verify-full
VZ_SQL_SSLROOTCERT=/etc/videojuegoszaragoza-sql/supabase-ca.crt
